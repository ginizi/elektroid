def cmd(args, cwd=None):
    p = subprocess.run(
        [str(x) for x in args],
        cwd=cwd,
        text=True,
        stdout=subprocess.PIPE,
        stderr=subprocess.STDOUT,
    )

    if p.returncode:
        raise RuntimeError(
            p.stdout.strip()
            or f"Erreur commande: {args}"
        )

    return p.stdout



class DTSession:
    def __init__(self, cli, device):
        self.proc = subprocess.Popen(
            [str(cli), "dt-session", str(device)],
            stdin=subprocess.PIPE,
            stdout=subprocess.PIPE,
            stderr=subprocess.STDOUT,
            text=True,
            bufsize=1,
        )

        while True:
            line = self.proc.stdout.readline()

            if not line:
                raise RuntimeError(
                    "dt-session terminée pendant la connexion"
                )

            if line.strip() == "DT_SESSION_READY":
                break

    def command(self, *parts):
        if self.proc.poll() is not None:
            raise RuntimeError(
                "dt-session n'est plus active"
            )

        line = "\t".join(str(x) for x in parts)

        self.proc.stdin.write(line + "\n")
        self.proc.stdin.flush()

        output = []

        while True:
            line = self.proc.stdout.readline()

            if not line:
                raise RuntimeError(
                    "dt-session interrompue"
                )

            line = line.rstrip("\n")
            output.append(line)

            if line.startswith("DT_OK\t"):
                return "\n".join(output)

            if line.startswith("DT_ERROR\t"):
                raise RuntimeError(
                    "\n".join(output)
                )

    def close(self):
        if not getattr(self, "proc", None):
            return

        if self.proc.poll() is None:
            try:
                self.proc.stdin.write("QUIT\n")
                self.proc.stdin.flush()
                self.proc.wait(timeout=3)
            except Exception:
                self.proc.terminate()
                try:
                    self.proc.wait(timeout=3)
                except subprocess.TimeoutExpired:
                    self.proc.kill()
                    self.proc.wait()

        self.proc = None


def check_destinations(jobs):
    occupied = []
    for bank in dict.fromkeys(job["bank"] for job in jobs):
        listing = cmd([CLI, "elektron:data:ls", f"{DEVICE}:/soundbanks/{bank}"])
        slots = set()
        for line in listing.splitlines():
            fields = line.split(maxsplit=6)
            if (len(fields) < 7 or fields[0] != "F"
                    or fields[2] not in ("0", "1")
                    or fields[3] not in ("0", "1")
                    or not fields[5].isdigit()):
                raise SystemExit("Liste des slots non reconnue ; aucune écriture autorisée")
            if not 1 <= int(fields[5]) <= 256:
                raise SystemExit("Slot distant invalide ; aucune écriture autorisée")
            # A listed sound is occupied even if its data is marked invalid.
            slots.add(int(fields[5]))
        occupied.extend(f"{bank}{job['slot']:03d}" for job in jobs
                        if job["bank"] == bank and job["slot"] in slots)
    return occupied


def confirm_execution(jobs, occupied):
    print(f"⚠ {len(jobs)} slots seront effacés puis réécrits.")
