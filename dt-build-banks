    except EOFError:
        raise SystemExit("Annulé : confirmation indisponible") from None
    if answer.strip() != "OUI":
        raise SystemExit("Annulé : aucune écriture effectuée")


def replace_sound(session, sound_file, bank, slot):
    path = f"/soundbanks/{bank}/{slot}"
    session.command("DATA_CL", path)
    session.command("DATA_UL", sound_file, path)


def make_sound_data(
    output,
    bank,
    slot,
    sound_name,
    sample_id,
    sample_size,
    sample_hash,
    source_folder,
):
    if source_folder not in FOLDER_TAGS:
        raise RuntimeError(f"Aucune catégorie vérifiée pour: {source_folder}")

    data = create_default_sound()

    if len(data) != 203:
        raise RuntimeError(
            f"Template invalide: {len(data)} octets "
            "(203 attendus)"
        )

    if data[:4] != bytes.fromhex("ac11d303"):
        raise RuntimeError(
            "Magic header invalide"
        )

    if data[-4:] != bytes.fromhex("aaa1daaa"):
        raise RuntimeError(
            "Magic footer invalide"
        )

    if data[29] != 0:
        raise RuntimeError(
            "Le template doit être non compressé"
        )

    if data[30] != 12:
        raise RuntimeError(
            "Footer inattendu"
        )

    if (int.from_bytes(data[25:29], "big") != 160
            or int.from_bytes(data[-8:-4], "big") != 160):
        raise RuntimeError("Taille du payload invalide")

    name = sound_name.encode("ascii")

    if len(name) > 15:
        raise RuntimeError(
            f"Nom Sound trop long: {sound_name}"
        )

    bank_index = ord(bank) - ord("A")

    if not 0 <= bank_index <= 7:
        raise RuntimeError(
            f"Banque invalide: {bank}"
        )

    if not 1 <= slot <= 256:
        raise RuntimeError(
            f"Slot invalide: {slot}"
        )

    file_index = (
        bank_index * 256
        + slot - 1
    )

    # file_index
    data[21:25] = file_index.to_bytes(
        4, "big"
    )

    # Nom Sound : champ 16 octets
    data[43:59] = (
        name
        + b"\x00" * (16 - len(name))
    )

    # Replace inherited tags, rather than accumulating the template's tags.
    # Header: 31 bytes; tag field: bytes 8..11 of the uncompressed payload.
    data[39:43] = FOLDER_TAGS[source_folder].to_bytes(4, "big")

    # Référence sample
    data[0xA3:0xA7] = sample_id.to_bytes(
        4, "big"
    )

    data[0xA7:0xAB] = sample_hash.to_bytes(
        4, "big"
    )

    data[0xAB:0xAF] = (
        sample_size + 16
    ).to_bytes(4, "big")

    data[0xAF:0xB3] = (
        sample_id + 0x28B8
    ).to_bytes(4, "big")

    # CRC footer
    crc = (
        zlib.crc32(
            data[31:-12],
            0xFFFFFFFF,
        )
        & 0xFFFFFFFF
    )

    data[-12:-8] = crc.to_bytes(
        4, "big"
    )

    Path(output).write_bytes(data)



def natural_key(s):
    return [
        int(x) if x.isdigit() else x.casefold()
        for x in re.split(r"(\d+)", s)
    ]


def format_slot_ranges(slots):
    groups = {}
    for slot in sorted(set(slots)):
        groups.setdefault(slot[0], []).append(int(slot[1:]))
    ranges = []
    for bank, numbers in groups.items():
        first = last = numbers[0]
        for number in numbers[1:] + [None]:
            if number is not None and number == last + 1:
                last = number
                continue
            ranges.append(f"{bank}{first:03d}" if first == last
                          else f"{bank}{first:03d}–{bank}{last:03d}")
            first = last = number
    return " · ".join(ranges)


