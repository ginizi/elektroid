                f"tag={TAG_NAMES[FOLDER_TAGS[job['source_folder']]]} "
                f"sample=/{job['remote']}/{job['remote_name']}"
            )


def hms(seconds):
    seconds = max(0, int(round(seconds)))

    h, rem = divmod(seconds, 3600)
    m, s = divmod(rem, 60)

    return f"{h:02d}:{m:02d}:{s:02d}"


def category_dir(root, aliases):
    for name in aliases:
        p = root / name

        if p.is_dir():
            return p

    return None


def parse_folder_spec(value):
    if ":" not in value:
        name, first, last = value, 1, None
    else:
        try:
            name, first, last = value.rsplit(":", 2)
            first, last = int(first), int(last)
        except ValueError:
            raise argparse.ArgumentTypeError(
                "Format attendu: '01 Kicks' ou '01 Kicks:21:40'"
            ) from None
        if not 1 <= first <= last:
            raise argparse.ArgumentTypeError("La plage doit respecter 1 <= début <= fin")
    if not any(name in aliases for _, _, aliases, _ in BANKS):
        raise argparse.ArgumentTypeError(
            f"Dossier inconnu: {name}. Dossiers acceptés: "
            + ", ".join(alias for _, _, aliases, _ in BANKS for alias in aliases)
        )
    return name, first, last


def parse_map(value):
    try:
        path, bank = value.rsplit(":", 1)
    except ValueError:
        raise argparse.ArgumentTypeError("Format attendu : DOSSIER:BANQUE") from None
    bank = bank.upper()
    if not path or len(bank) != 1 or bank not in "ABCDEFGH":
        raise argparse.ArgumentTypeError("Dossier requis et banque comprise entre A et H")
    return {"path": path, "bank": bank}


def parse_range(value):
    try:
        first, last = (int(part) for part in value.split(":"))
    except ValueError:
        raise argparse.ArgumentTypeError("Format attendu : DÉBUT:FIN") from None
    if not 1 <= first <= last:
        raise argparse.ArgumentTypeError("La plage doit respecter 1 <= début <= fin")
    return first, last


class MapAction(argparse.Action):
    def __call__(self, parser, namespace, values, option_string=None):
        maps = list(getattr(namespace, "maps", None) or [])
        maps.append(values)
        namespace.maps = maps


class MapOptionAction(argparse.Action):
    def __call__(self, parser, namespace, values, option_string=None):
        maps = getattr(namespace, "maps", None)
        if not maps:
            if self.dest == "limit":
                namespace.limit = values
                return
            parser.error(f"{option_string} doit suivre un --map")
        if self.dest in maps[-1]:
            parser.error(f"{option_string} répété dans le même --map")
        maps[-1][self.dest] = values


def build_maps_plan(root, maps):
    jobs, summary = [], []
    slots, sources, remote_names = set(), set(), set()
    for mapping in maps:
        folder = Path(mapping["path"]).expanduser()
        folder = (folder if folder.is_absolute() else root / folder).resolve()
        first, last = mapping.get("range", (1, None))
        selected, details = build_plan(
            folder.parent, mapping.get("limit"), [(folder.name, first, last)],
            mapping["bank"], mapping.get("from_slot", 1))
        for job in selected:
            slot = (job["bank"], job["slot"])
            source = job["wav"].resolve()
            remote = (job["remote"], job["remote_name"].casefold())
            if slot in slots:
                raise SystemExit(f"Collision de destination : {job['bank']}{job['slot']:03d}")
            if source in sources:
                raise SystemExit(f"Sélections source qui se chevauchent : {source}")
            if remote in remote_names:
                raise SystemExit(f"Collision de nom +Drive : {remote}")
            slots.add(slot)
            sources.add(source)
            remote_names.add(remote)
        jobs.extend(selected)
        summary.extend(details)
    return jobs, summary


def build_plan(root, limit, folders=None, bank=None, start_slot=None):
    if limit is not None and not 1 <= limit <= 256:
        raise SystemExit("--limit doit être compris entre 1 et 256")
    if bank is not None:
        bank = bank.upper()
        if bank not in "ABCDEFGH" or len(bank) != 1:
            raise SystemExit("--bank doit être compris entre A et H")
    if start_slot is not None and not 1 <= start_slot <= 256:
        raise SystemExit("--start-slot doit être compris entre 1 et 256")
    if (bank is not None or start_slot is not None) and (not folders or len(folders) != 1):
        raise SystemExit("Le placement explicite nécessite exactement un --folder")
    target_bank = bank
    jobs = []
    summary = []

    selections = []
    occupied = set()
    if folders:
        for name, first, last in folders:
            if not any(name in row[2] for row in BANKS):
                raise SystemExit(f"Catégorie de dossier non prise en charge : {name}")
            bank, label, aliases, remote = next(
                row for row in BANKS if name in row[2]
            )
            folder = root / name
            if not folder.is_dir():
                raise SystemExit(f"Dossier sélectionné introuvable: {folder}")
            selections.append((bank, label, remote, folder, first, last))
    else:
        selections = [
            (bank, label, remote, category_dir(root, aliases), 1, None)
            for bank, label, aliases, remote in BANKS
        ]

    remote_names = {}
    for bank, label, remote, folder, first, last in selections:

        wavs = []

        if folder:
            wavs = sorted(
                [
                    p
                    for p in folder.rglob("*")
                    if p.is_file()
                    and p.suffix.lower() == ".wav"
                ],
                key=lambda p: natural_key(
                    str(p.relative_to(folder))
                ),
            )
        elif folders:
            raise SystemExit("Dossier sélectionné introuvable")
        else:
            continue

        # Banque E : uniquement les cowbells du dossier Percussion.
        if bank == "E":
            wavs = [
                p for p in wavs
                if re.search(
                    r"cow[ _-]*bell|cowbell|cowbel|cowb",
                    p.stem,
                    re.IGNORECASE,
                )
            ]

        # Les indices suivent le tri naturel et le filtre cowbells existants.
        if not wavs:
            raise SystemExit(f"Aucun WAV sélectionnable: {folder}")
        if first > len(wavs) or (last is not None and last > len(wavs)):
            raise SystemExit(f"Plage inexistante dans {folder}: {len(wavs)} samples disponibles")
        wavs = wavs[first - 1:last]
        if limit:
            wavs = wavs[:limit]
        source_slots = {(folder.name, rank) for rank in range(first, first + len(wavs))}
        if occupied & source_slots:
            raise SystemExit(f"Sélections source qui se chevauchent: {folder.name}")
        occupied.update(source_slots)

        destination_start = start_slot if start_slot is not None else first
        available = 257 - destination_start
        if len(wavs) > available:
            raise SystemExit(
                f"{len(wavs)} sounds demandés, {available} slots disponibles "
                f"({destination_start}–256). Choisissez un slot de départ ≤ "
                f"{257 - len(wavs)} ou réduisez la sélection à {available} sounds."
            )
        bank = target_bank or bank

        #
        # Tous les WAV de la catégorie sont placés
        # dans un seul dossier +Drive.
        #
        # Donc deux fichiers ne peuvent pas avoir
        # exactement le même nom.
        #

        for p in wavs:

            stem = p.stem
            remote_name = stem[:32].rstrip(" .")
            if not remote_name or any(c in remote_name for c in "\t\r\n"):
                raise SystemExit(f"Nom +Drive invalide: {p.name}")
            key = (remote, remote_name.casefold())

            if key in remote_names:
                raise SystemExit(
                    f"Doublon de nom +Drive dans {bank}:\n"
                    f"{remote_names[key]}\n"
                    f"{p}"
                )

            remote_names[key] = p

            try:
                stem.encode("cp1252")

            except UnicodeEncodeError:
                raise SystemExit(
                    f"Nom non CP1252: {p.name}"
                )

            # Le +Drive Elektron limite le nom à 32 caractères.
            # Le fichier WAV local n'est jamais renommé.
            # La version distante est tronquée uniquement si nécessaire.

        for offset, wav in enumerate(wavs):
            slot = destination_start + offset
            if any(job["bank"] == bank and job["slot"] == slot for job in jobs):
                raise SystemExit(f"Collision de destination: {bank}{slot:03d}")

            jobs.append({
                "bank": bank,
                "label": label,
                "source_folder": folder.name,
                "remote": remote,
                "slot": slot,
                "source_rank": first + offset,
                "wav": wav,
                "remote_name": wav.stem[:32].rstrip(" ."),
            })

        summary.append(
            (
                bank,
                label,
                len(wavs),
                folder,
                remote,
                destination_start,
                destination_start + len(wavs) - 1,
            )
        )

    return jobs, summary


def estimate_eta(durations, sizes, remaining):
    """
    Estimation dynamique.

    Au début :
        moyenne du temps par sample.

    Après 4 samples :
        estimation selon la taille des WAV
        + coût fixe par Sound.
    """

    if not durations or not remaining:
        return 0.0

    if len(durations) < 4:
        average = sum(durations) / len(durations)

        return average * len(remaining)

    mean_size = sum(sizes) / len(sizes)
    mean_time = sum(durations) / len(durations)

    denominator = sum(
        (x - mean_size) ** 2
        for x in sizes
    )

    if not denominator:
        return mean_time * len(remaining)

    slope = sum(
        (x - mean_size) * (y - mean_time)
        for x, y in zip(sizes, durations)
    ) / denominator

    slope = max(0.0, slope)

    fixed = max(
        0.0,
        mean_time - slope * mean_size,
    )

    return sum(
        max(
            0.5,
            fixed
            + slope * job["wav"].stat().st_size,
        )
        for job in remaining
    )


def main():
    global DEVICE

    parser = argparse.ArgumentParser(
        description=(
            "Construction automatique "
            "des Sound Banks A-H du Digitakt"
        )
    )

    parser.add_argument(
        "root",
        type=Path,
        help=(
            "racine contenant "
            "KICK, SNARE, TOM, etc."
        ),
    )

    parser.add_argument(
        "--dry-run",
        action="store_true",
        help="afficher le plan sans connexion MIDI ni écriture",
    )

    parser.add_argument(
        "--limit",
        type=int,
        action=MapOptionAction,
        help=(
            "N WAV maximum par banque "
            "(utile pour tester)"
        ),
    )

    parser.add_argument(
        "--folder", action="append", type=parse_folder_spec,
        metavar="DOSSIER[:DÉBUT:FIN]",
        help=("sélectionner un dossier entier ou ses WAV de rang DÉBUT à FIN "
              "(tri naturel, plage inclusive, rangs à partir de 1); "
              "répétable, ex. --folder '01 Kicks:21:40'"),
    )

    parser.add_argument("--bank", help="banque cible A–H (un seul --folder)")
    parser.add_argument("--start-slot", type=int,
                        help="premier slot cible 1–256 (un seul --folder)")
    parser.add_argument("--map", dest="maps", type=parse_map, action=MapAction,
                        help="DOSSIER:BANQUE ; ouvre un groupe source/destination")
    parser.add_argument("--device", type=int, default=int(DEVICE),
                        help="indice MIDI du Digitakt (global ; défaut %(default)s)")
    parser.add_argument("--verbose", action="store_true",
                        help="afficher les fichiers, rangs et chemins du plan")
    parser.add_argument("--range", type=parse_range, action=MapOptionAction,
                        help="DÉBUT:FIN, plage source du dernier --map")
    parser.add_argument("--from-slot", type=int, action=MapOptionAction,
                        help="premier slot cible du dernier --map (défaut 1)")

    args = parser.parse_args()
    if args.device < 0:
        parser.error("--device doit être un entier non négatif")
    DEVICE = str(args.device)
    if args.maps and (args.folder or args.bank or args.start_slot is not None or args.limit is not None):
        parser.error("--map ne se mélange pas avec --folder, --bank, --start-slot ou une limite globale")

    root = args.root.expanduser().resolve()

    #
    # Vérifications
    #

    if not root.is_dir():
        sys.exit(
            f"Racine introuvable: {root}"
        )

    create_default_sound()  # Validate built-in parameters before MIDI.

    if not CLI.is_file():
        sys.exit(
            f"elektroid-cli introuvable: {CLI}"
        )

    if not MAKE.is_file():
        sys.exit(
            f"dt-make-sound introuvable: {MAKE}"
        )

    if (
        args.limit is not None
        and not 1 <= args.limit <= 256
    ):
        sys.exit(
            "--limit doit être entre 1 et 256"
        )

    #
    # Préparation
    #

    if args.maps:
        jobs, summary = build_maps_plan(root, args.maps)
    else:
        jobs, summary = build_plan(root, args.limit, args.folder,
                                   args.bank, args.start_slot)

    print_plan(jobs, summary, args.verbose)

    if not jobs:
        sys.exit(
            "Aucun WAV trouvé."
        )

    #
    # Avec --dry-run :
    # uniquement prévisualisation.
    #

    if args.dry_run:

        print()
        print(
            "Aucun upload effectué."
        )

        print(
            "Relance sans --dry-run pour exécuter après confirmation."
        )

        return

    print()
    devices = cmd([CLI, "ld"])
    expected = (f"{DEVICE}: id: Elektron Digitakt :: Elektron Digitakt; "
                "name: Elektron Digitakt :: Elektron Digitakt")
    if expected not in devices.splitlines():
        sys.exit("Indice MIDI configuré non identifié comme Digitakt ; aucune écriture")
    occupied = check_destinations(jobs)
    confirm_execution(jobs, occupied)

    print(
        "Démarrage dans 3 secondes "
        "(Ctrl-C pour annuler)..."
    )

    time.sleep(3)

    #
    # Création dossiers +Drive
    #

    for remote in dict.fromkeys(job["remote"] for job in jobs):

        cmd([
            CLI,
            "elektron:sample:mkdir",
            f"{DEVICE}:/{remote}",
        ])

    #
    # Les .data générés sont conservés ici.
    #

    work = BASE / "generated_sounds"
    work.mkdir(exist_ok=True)

    start = time.monotonic()

    durations = []
    sizes = []
    failures = []

    success = 0

    #
    # Traitement
    #

    session = DTSession(CLI, DEVICE)
    atexit.register(session.close)

    #
    # Passage normal + retry des échecs
    #

    original_jobs = list(jobs)

    first_pass_failures = 0
    retry_attempted = 0
    retry_success = 0

    for pass_no in (1, 2):

        if pass_no == 1:

            jobs = original_jobs

        else:

            if not failures:
                break

            retry_jobs = [
                job
                for job, error in failures
            ]

            first_pass_failures = len(retry_jobs)
            retry_attempted = len(retry_jobs)

            print("\n" + "=" * 72)
            print("RETRY DES ÉCHECS")
            print("=" * 72)

            for job, error in failures:

                first_line = (
                    error.splitlines()[0]
                    if error
                    else "Erreur inconnue"
                )

                print(
                    f"- {job['bank']}"
                    f"{job['slot']:03d} "
                    f"{job['wav'].name}: "
                    f"{first_line}"
                )

            print()
            print(
                f"{retry_attempted} job(s) "
                "seront retenté(s)."
            )

            #
            # Une nouvelle connexion est préférable pour le retry :
            # si l'échec venait de l'USB/session, on repart proprement.
            #

            session.close()

            session = DTSession(
                CLI,
                DEVICE,
            )

            atexit.register(
                session.close
            )

            failures = []
            jobs = retry_jobs

            success_before_retry = success

        for position, job in enumerate(
            jobs,
            start=1,
        ):

            item_start = time.monotonic()

            wav = job["wav"]
            slot = job["slot"]

            sound_name = (
                f"{slot:02d}_{job['label']}"
            )

            remote_name = job["remote_name"]

            remote_sample = (
                f"/{job['remote']}/"
                f"{remote_name}"
            )

            print()
            print("=" * 72)

            print(
                f"[{position:04d}/{len(jobs):04d}] "
                f"{job['bank']}{slot:03d}  "
                f"{sound_name}"
            )

            print(
                f"WAV    : {wav.name}"
            )

            print(
                f"+Drive : "
                f"/{job['remote']}/{remote_name}"
            )

            try:

                #
                # 1. WAV -> +Drive
                #

                print(
                    "1/2  Upload sample...",
                    end="",
                    flush=True,
                )

                #
                # Nettoyage WAV avant upload.
                #
                # Certains WAV de la bibliothèque sont lisibles par macOS
                # mais refusés par libsndfile. On les réécrit avec ffmpeg
                # sans modifier les fichiers originaux.
                #
                timings = {}

                upload_dir = work / "_upload_clean"
                upload_dir.mkdir(exist_ok=True)

                upload_wav = (
                    upload_dir
                    / f"{remote_name}.wav"
                )

                if upload_wav.exists():
                    upload_wav.unlink()

                phase_start = time.monotonic()

                cmd([
                    "ffmpeg",
                    "-y",
                    "-v", "error",
                    "-i", wav,
                    "-map_metadata", "-1",
                    "-c:a", "pcm_s16le",
                    upload_wav,
                ])

                timings["ffmpeg"] = (
                    time.monotonic() - phase_start
                )

                phase_start = time.monotonic()

                session.command(
                    "SAMPLE_UL",
                    upload_wav,
                    f"/{job['remote']}",
                )

                timings["sample_upload"] = (
                    time.monotonic() - phase_start
                )

                print(" OK")

                #
                # 2. Sample -> Sound
                #

                print(
                    "2/2  Création + upload Sound...",
                    end="",
                    flush=True,
                )

                #
                # META 0x22 + 0x28 dans la session existante
                #

                phase_start = time.monotonic()

                meta_output = session.command(
                    "META",
                    remote_sample,
                )

                timings["metadata"] = (
                    time.monotonic() - phase_start
                )

                meta = re.search(
                    r"SAMPLE_INFO "
                    r"id=([0-9A-Fa-f]{8}) "
                    r"size=([0-9]+) "
                    r"hash=([0-9A-Fa-f]{8})",
                    meta_output,
                )

                if not meta:
                    raise RuntimeError(
                        "SAMPLE_INFO introuvable:\n"
                        + meta_output
                    )

                sample_id = int(
                    meta.group(1), 16
                )

                sample_size = int(
                    meta.group(2)
                )

                sample_hash = int(
                    meta.group(3), 16
                )

                #
                # Génération locale du Sound
                #

                phase_start = time.monotonic()

                sound_file = (
                    work
                    / (
                        f"{job['bank']}"
                        f"{slot:03d}_"
                        f"{sound_name}.data"
                    )
                )

                make_sound_data(
                    sound_file,
                    job["bank"],
                    slot,
                    sound_name,
                    sample_id,
                    sample_size,
                    sample_hash,
                    job["source_folder"],
                )

                timings["generate"] = (
                    time.monotonic() - phase_start
                )

                #
                # Upload Sound dans LA MÊME session
                #

                phase_start = time.monotonic()

                replace_sound(
                    session,
                    sound_file,
                    job["bank"], slot,
                )

                timings["sound_upload"] = (
                    time.monotonic() - phase_start
                )

                print(" OK")

                success += 1

            except Exception as exc:

                print(" ECHEC")

                print(str(exc))

                failures.append(
                    (
                        job,
                        str(exc),
                    )
                )
                session.close()
                completed = ", ".join(
                    f"{item['bank']}{item['slot']:03d}"
                    for item in original_jobs[:position - 1]
                ) or "aucun"
                pending = ", ".join(
                    f"{item['bank']}{item['slot']:03d}"
                    for item in original_jobs[position:]
                ) or "aucun"
                raise SystemExit(
                    f"Arrêt sur {job['bank']}{slot:03d}. "
                    f"Terminés : {completed}. Non exécutés : {pending}. "
                    "Le slot en erreur peut avoir été partiellement modifié."
                ) from exc

            #
            # Statistiques / ETA
            #

            duration = (
                time.monotonic()
                - item_start
            )

            durations.append(duration)
            sizes.append(
                wav.stat().st_size
            )

            elapsed = (
                time.monotonic()
                - start
            )

            remaining_jobs = (
                jobs[position:]
            )

            remaining = estimate_eta(
                durations,
                sizes,
                remaining_jobs,
            )

            finish = (
                datetime.now()
                + timedelta(
                    seconds=remaining
                )
            )

            percent = (
                position
                / len(jobs)
                * 100
            )

            # Affichage progression
            bar_width = 30
            filled = int(
                bar_width * position / len(jobs)
            )
            bar = (
                "#" * filled
                + "-" * (bar_width - filled)
            )

            errors = len(failures)

            # Efface le terminal et replace le curseur en haut.
            print("\033[2J\033[H", end="", flush=True)

            print("=" * 72)
            print(
                f"[{position:04d}/{len(jobs):04d}] "
                f"{job['bank']}{job['slot']:03d}  "
                f"{job['wav'].name}"
            )
            print("-" * 72)

            print(
                f"Progression : [{bar}] "
                f"{percent:5.1f} %"
            )

            print()
            print(
                f"Réussites   : {success}"
            )
            print(
                f"Erreurs     : {errors}"
            )

            if errors == 0:
                print("État        : OK")
            else:
                print(
                    f"État        : "
                    f"{errors} ERREUR(S)"
                )

            print()
            print("Temps du dernier Sound")
            print("-" * 32)

            def show_phase(label, key):
                value = timings.get(key)
                if value is None:
                    text = "---"
                else:
                    text = f"{value:6.2f} s"
                print(f"{label:<14}: {text}")

            show_phase("FFmpeg", "ffmpeg")
            show_phase("Upload WAV", "sample_upload")
            show_phase("Métadonnées", "metadata")
            show_phase("Génération", "generate")
            show_phase("Upload Sound", "sound_upload")

            measured = sum(
                timings.get(k, 0.0)
                for k in (
                    "ffmpeg",
                    "sample_upload",
                    "metadata",
                    "generate",
                    "sound_upload",
                )
            )

            print("-" * 32)
            print(f"Mesuré        : {measured:6.2f} s")

            print()
            print(
                f"Dernier     : {hms(duration)}"
            )
            print(
                f"Écoulé      : {hms(elapsed)}"
            )
            print(
                f"Restant     : ~{hms(remaining)}"
            )
            print(
                f"Fin estimée : "
                f"{finish:%H:%M:%S}"
            )


        if pass_no == 2:
            retry_success = (
                success
                - success_before_retry
            )

    # Remet la liste originale pour le résumé/statistiques.
    jobs = original_jobs

    #
    # Résumé
    #

    elapsed = (
        time.monotonic()
        - start
    )

    print()
    print("=" * 72)
    print("TERMINÉ")
    print("=" * 72)

    print(
        f"Durée totale : "
        f"{hms(elapsed)}"
    )

    print(
        f"Réussites    : "
        f"{success}"
    )

    if retry_attempted:

        print(
            f"Échecs init. : "
            f"{first_pass_failures}"
        )

        print(
            f"Retentés     : "
            f"{retry_attempted}"
        )

        print(
            f"Récupérés    : "
            f"{retry_success}"
        )

        print(
            f"Échecs finaux: "
            f"{len(failures)}"
        )

    else:

        print(
            f"Échecs       : "
            f"{len(failures)}"
        )

    if failures:

        print()
        print("Échecs:")

        for job, error in failures:

            first_line = (
                error.splitlines()[0]
                if error
                else "Erreur inconnue"
            )

            print(
                f"- {job['bank']}"
                f"{job['slot']:03d} "
                f"{job['wav'].name}: "
                f"{first_line}"
            )

        sys.exit(1)


if __name__ == "__main__":

    try:
        main()

    except KeyboardInterrupt:

        print()
        print("Interrompu.")

        sys.exit(130)
